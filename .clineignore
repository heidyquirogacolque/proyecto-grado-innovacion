# ==========================================
#  Cline AI Ignore File
# ==========================================

# Excluir binarios pesados y PDFs
*.pdf
main.pdf
!docs/*.pdf

# Excluir temporales y auxiliares de compilación LaTeX
*.aux
*.log
*.toc
*.lof
*.lot
*.out
*.bbl
*.blg
*.run.xml
*.bcf
*.fdb_latexmk
*.fls
*.synctex.gz
*.upa
*.upb
*.listing
*-blx.bib

# Auxiliares en subdirectorios
capitulos/**/*.aux
docs/**/*.aux
preliminares/**/*.aux
anexos/**/*.aux
estilos/**/*.aux
tablas/**/*.aux
codigo/**/*.aux
imagenes/**/*.aux

# Directorios de configuración y caché de IDEs
.antigravitycli/
.cline/
.cursor/
.idea/
.vscode/

